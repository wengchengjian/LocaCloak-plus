{
  "action": {
    "default_icon": {
      "128": "icons/icon-128.png",
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": ["page-main.js"],
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "world": "MAIN",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "all_frames": true,
      "js": ["content.js"],
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "enabled": true,
        "id": "ruleset_1",
        "path": "rules.json"
      }
    ]
  },
  "description": "Cloak your locale — override timezone, geolocation, and language to match your VPN exit location.",
  "host_permissions": ["<all_urls>"],
  "icons": {
    "128": "icons/icon-128.png",
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png"
  },
  "manifest_version": 3,
  "name": "LocaCloak-plus",
  "options_ui": {
    "open_in_tab": true,
    "page": "options.html"
  },
  "permissions": ["storage", "declarativeNetRequest", "privacy", "alarms"],
  "version": "1.4.0"
}
